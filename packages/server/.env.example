# Copy to `.env` and edit. `.env` is gitignored.

PORT=4000

# Where calls are stored.
#   memory    - in-process, reseeded on restart. Zero setup. DEFAULT.
#   firestore - real Google Cloud Firestore.
DATA_BACKEND=memory

# Only needed when DATA_BACKEND=firestore:
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
