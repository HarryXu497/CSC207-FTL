# Copy to `.env` and edit. `.env` is gitignored.

PORT=4000

# Where calls are stored.
#   memory    - in-process, default and reseeded on restart
#   firestore - Firebase Firestore.
DATA_BACKEND=memory

# Only needed when DATA_BACKEND=firestore:
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Document ingestion (optional). Requires a running Chroma server and an OpenAI API key.
RAG_ENABLED=false

# Customer simulation (optional). Requires company documents already stored in Chroma.
SIMULATION_ENABLED=false
# SIMULATION_MODEL=your-chat-model

# Shared ingestion and retrieval settings. Keep the embedding model and collection consistent.
# OPENAI_API_KEY=your-openai-api-key
# ACCURACY_MODEL=gpt-4o-mini
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# CHROMA_URL=http://localhost:8000
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# CHROMA_COLLECTION=documents

# Local sentiment models. Run npm run models:download before enabling.
# MODEL_DIR=models
