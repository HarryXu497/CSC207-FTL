{
  "name": "recall-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "ReCall MVP - minimal FERN slice: React dashboard <-> Express API <-> database.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names \"server,web\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace @recall/server run dev",
    "dev:web": "npm --workspace @recall/web run dev",
    "build": "npm run typecheck && npm --workspace @recall/web run build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "models:download": "pip install -U huggingface_hub && hf download SamLowe/roberta-base-go_emotions --local-dir packages/server/models/goemotions-roberta && hf download ShayanBhatti/vad-bert-onnx --local-dir packages/server/models/vad"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
